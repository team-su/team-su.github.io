&lt;script&gt;
(function () {
 var root = document.currentScript &amp;&amp; document.currentScript.previousElementSibling;
 if (!root || !root.classList.contains('honors-wall')) {
 root = document.querySelector('.honors-wall');
 }
 if (!root) return;
 var buttons = root.querySelectorAll('.honors-filter__btn');
 var years = root.querySelectorAll('.honors-year');
 function apply(mode) {
 root.setAttribute('data-filter', mode);
 buttons.forEach(function (btn) {
 var on = btn.getAttribute('data-filter') === mode;
 btn.classList.toggle('is-active', on);
 btn.setAttribute('aria-pressed', on ? 'true' : 'false');
 });
 years.forEach(function (year) {
 var rows = year.querySelectorAll('.honors-row');
 var visible = 0;
 rows.forEach(function (row) {
 var show = mode === 'all' || row.getAttribute('data-gold') === '1';
 row.hidden = !show;
 if (show) visible += 1;
 });
 year.hidden = visible === 0;
 });
 }
 buttons.forEach(function (btn) {
 btn.addEventListener('click', function () {
 apply(btn.getAttribute('data-filter'));
 });
 });
})();
