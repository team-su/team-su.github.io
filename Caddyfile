# su-team 静态站
# www 还指 GitHub 时不要写进下面，否则 ACME 会失败。
# www CNAME 改成 su-team.cn. 之后把这段打开：
#
#   www.su-team.cn {
#       redir https://su-team.cn{uri} 308
#   }

{
	email suers_xctf@126.com
}

(static_site) {
	root * /var/www/su-team
	encode gzip zstd
	try_files {path} {path}/index.html {path}/
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}

	@assets path *.woff2 *.webp *.jpg *.png *.svg *.ico *.gif *.woff
	header @assets Cache-Control "public, max-age=2592000"

	@hashed path_regexp \.[a-f0-9]{16,}\.(css|js)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@code {
		path *.css *.js
		not path_regexp \.[a-f0-9]{16,}\.(css|js)$
	}
	header @code Cache-Control "public, max-age=86400"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

http://156.239.238.130 {
	import static_site
}

su-team.cn {
	import static_site
}

